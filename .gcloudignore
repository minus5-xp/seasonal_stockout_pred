# ============================================================================
# gcloud ignore for Cruzber Option B Pipeline
# ============================================================================
# This file is used by "gcloud builds submit" and "gcloud app deploy"
# Strategy: Exclude everything by default, then whitelist only what's needed
# WITHOUT this file: 56.7 GiB uploaded (2061 files)
# WITH this file: < 50 MB expected
# ============================================================================

# ============================================================================
# 1. EXCLUDE EVERYTHING BY DEFAULT
# ============================================================================
*

# ============================================================================
# 2. WHITELIST: Include ONLY essential project files
# ============================================================================
# Core application code
!src/
!src/**/*.py

# SQL queries and BQML scripts
!sql/
!sql/**/*.sql
!sql/**/*.yml
!sql/**/*.yaml
!sql/**/README*.md

# Utility scripts
!scripts/
!scripts/**/*.py
!scripts/**/*.sh
!scripts/**/*.ps1

# Essential docs
!docs/
!docs/**/*.md

# Python dependencies
!requirements.txt

# Docker files
!Dockerfile
!.dockerignore

# Main README
!README.md
!00_*.md

# ============================================================================
# 3. EXPLICIT EXCLUDES: Remove unwanted items
# ============================================================================

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Jupyter notebooks (HUGE - exclude all)
*.ipynb
.ipynb_checkpoints/

# Data files (CSV, Excel, Parquet are massive)
*.csv
*.xlsx
*.xls
*.parquet
*.feather
*.arrow
*.db
*.sqlite
*.json.gz
*.pkl
*.pickle

# Backup files
*.backup
*.backup_*
*.bak
*~

# Log files
*.log

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Git directory (gcloud auto-excludes .git but being explicit)
.git/
.gitignore
.gitattributes

# Virtual environments
venv/
env/
ENV/
.venv/

# Build artifacts
build/
dist/
*.egg-info/

# Test outputs and temporary files
outputs/
output/
results/
results_h4/
temp/
tmp/
reports_generated/
paper/

# ============================================================================
# 4. EXCLUDE OTHER PROJECT DIRECTORIES (these add 56+ GB)
# ============================================================================
# Exclude all other subprojects not part of Option B pipeline
chatgpt_analysis/
gcp-bq-query-runner/
gcp-stockout-trainer/
oos_seasonal_fillrate/
seasonal_stockout_h4_clean/
ablation_*/
models/
experiments/

# Exclude large analysis files at root level
Analisis_*.ipynb
PAPER_*.ipynb
audit_*.csv
baseline_*.csv
ablation_*.csv
*_summary.csv
*_comparison*.csv
*_results*.csv
*_final.csv

# ============================================================================
# 5. GCLOUD DEFAULTS (keep these)
# ============================================================================
# This section is typically auto-generated by gcloud
.gcloudignore
#!include:.gitignore

erDiagram
    %% Jerarquía Geográfica
    dim_nacion ||--o{ dim_provincia : "codigo_nacion"
    dim_provincia ||--o{ dim_municipio : "codigo_provincia"
    dim_municipio ||--o{ dim_cliente : "codigo_municipio"
    
    %% Relaciones con Tabla de Hechos
    dim_cliente ||--o{ fact_lineas_albaran : "codigo_cliente"
    dim_articulo ||--o{ fact_lineas_albaran : "codigo_articulo"
    
    %% Relaciones Dimensión-Dimensión
    dim_familia ||--o{ dim_articulo : "codigo_familia"
    dim_canal ||--o{ dim_cliente : "canal_venta"
    
    %% Tablas Dimensionales
    
    dim_nacion {
        VARCHAR(10) codigo_nacion PK "Código país"
        VARCHAR(100) nacion "Nombre país"
    }
    
    dim_provincia {
        VARCHAR(10) codigo_provincia PK "Código provincia"
        VARCHAR(100) provincia "Nombre provincia"
        VARCHAR(10) codigo_nacion FK "Código país"
    }
    
    dim_municipio {
        VARCHAR(10) codigo_municipio PK "Código municipio"
        VARCHAR(150) municipio "Nombre municipio"
        VARCHAR(10) codigo_provincia FK "Código provincia"
    }
    
    dim_cliente {
        VARCHAR(20) codigo_cliente PK "Código cliente"
        VARCHAR(255) nombre_cliente "Nombre cliente"
        VARCHAR(10) codigo_municipio FK "Código municipio"
        VARCHAR(50) canal_venta FK "Canal de venta"
        DATE fecha_alta "Fecha de alta"
    }
    
    dim_familia {
        VARCHAR(20) codigo_familia PK "Código familia"
        VARCHAR(255) descripcion_familia "Descripción familia"
    }
    
    dim_canal {
        VARCHAR(50) canal_venta PK "Canal de venta"
        VARCHAR(100) agrupacion_canal "Agrupación canal"
    }
    
    dim_articulo {
        VARCHAR(30) codigo_articulo PK "Código artículo"
        VARCHAR(255) descripcion_articulo "Descripción artículo"
        VARCHAR(20) codigo_familia FK "Código familia producto"
        DECIMAL(15-4) precio_venta "Precio de venta"
        DECIMAL(15-4) coste_estandar "Coste estándar"
    }
    
    %% Tabla de Hechos
    
    fact_lineas_albaran {
        BIGINT id_linea PK "Clave sustituta AUTO_INCREMENT"
        VARCHAR(20) codigo_cliente FK "Código cliente"
        VARCHAR(30) codigo_articulo FK "Código artículo"
        VARCHAR(50) numero_albaran "Número de albarán"
        INT numero_linea "Número de línea"
        DATE fecha_albaran "Fecha albarán"
        INT unidades "Cantidad"
        DECIMAL(15-4) importe_bruto "Importe bruto"
        DECIMAL(8-4) por_descuento "Porcentaje descuento"
        DECIMAL(8-4) por_descuento2 "Porcentaje descuento 2"
        DECIMAL(15-4) importe_neto "Importe neto"
        DECIMAL(8-4) por_pronto_pago "Porcentaje pronto pago"
        DECIMAL(15-4) importe_liquido "Importe líquido"
        DECIMAL(8-4) por_iva "Porcentaje IVA"
        DECIMAL(15-4) base_imponible "Base imponible AUTORITATIVA"
        DECIMAL(15-4) importe_coste "Importe coste"
        DECIMAL(15-4) margen_beneficio "Margen de beneficio CALCULADO"
        DECIMAL(8-4) por_margen_beneficio "Porcentaje margen CALCULADO"
    }
